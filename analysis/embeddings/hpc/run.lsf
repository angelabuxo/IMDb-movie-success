#!/bin/bash
# DTU HPC batch job for the embedding analysis: mask the sampled reviews (spaCy transformer NER on the GPU),
# embed all three corpora, run the correlations and shuffle nulls on the node's cores, then the leak audits.
# Submitted by analysis/embeddings/hpc/push_and_submit.sh from /dtu/blackhole/0e/223278/.sg02805/embeddings.
# The folder is owner-only (umask 077): private/ holds review, screenplay and summary text.
#BSUB -J emb02805
#BSUB -q gpuv100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=6GB]"
#BSUB -W 5:00
#BSUB -o lsf_%J.out
#BSUB -e lsf_%J.err

set -euo pipefail
umask 077
module load python3/3.12.11
B=/dtu/blackhole/0e/223278/.sg02805
# spaCy's transformer model and pyarrow live in scratch: the home quota is full
export HF_HOME=$B/hf PYTHONPATH=$B/pylib PYTHONUNBUFFERED=1 TMPDIR=$B/tmp
export IMDB_DATA_DIR=/dtu/blackhole/0e/223278/.sg02805/embeddings/data EMBED_JOBS=${LSB_DJOB_NUMPROC:-8}
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
cd /dtu/blackhole/0e/223278/.sg02805/embeddings
mkdir -p "$IMDB_DATA_DIR/features"
nvidia-smi > nvidia-smi_$LSB_JOBID.txt 2>&1 || true
P=~/venvs/sg02805/bin/python
step() { echo "$(date '+%F %T') $*"; "$P" -m "$@"; }
step analysis.embeddings.s01_corpora mask-reviews
step analysis.embeddings.s02_embed
step analysis.embeddings.s03_correlate
step analysis.embeddings.s04_leak_audit
step analysis.embeddings.tag_entity_check
"$P" - <<'PY'
import pandas as pd
from analysis.embeddings import tag_entity_check as T
pd.concat([T.typed(m) for m in ("en_core_web_sm", "en_core_web_trf")]).to_csv("analysis/embeddings/private/tag_types.csv", index=False)
print("tag types done")
PY
echo "$(date '+%F %T') all done"
