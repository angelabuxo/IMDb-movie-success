 "s03_clean": {
  "config": "d53695adc3",
  "date": "2026-11-11",
  "outputs": [
   "s03_names.csv",
   "s03_rank_frequency.csv",
   "s03_stages.csv",
   "s03_summary.json",
   "s03_top_terms.csv"
  ],
  "params": {
   "text": {
    "layers": [
     "dialogue",
     "action",
     "full"
    ],
    "lowercase": true,
    "min_dialogue_words": 500,
    "min_scenes_flag": 20,
    "min_token_length": 2,
    "names": {
     "min_label_lines": 1,
     "source_check": "spacy_ner_person",
     "source_primary": "moviesum_labels"
    },
    "normalise_split_contractions": true,
    "spacy_batch_chars": 100000,
    "spacy_model": "en_core_web_sm",
    "token_regex": "[A-Za-z]+(?:'[A-Za-z]+)?",
    "variants": {
     "lemmatize": [
      "off",
      "on"
     ],
     "stopwords": [
      "kept",
      "removed"
     ]
    }
   }
  }
 },
