 "s02_units": {
  "config": "03e51e86b0",
  "date": "2026-11-14",
  "outputs": [
   "analysis_table.csv",
   "s02_parser_report.csv",
   "s02_scene_counts.csv.gz",
   "s02_summary.json"
  ],
  "params": {
   "arc_ready": {
    "min_scene_tags": 20,
    "min_sentences": 300,
    "sensitivity_loose": {
     "min_scene_tags": 10,
     "min_sentences": 150
    },
    "sensitivity_strict": {
     "min_scene_tags": 40,
     "min_sentences": 600
    }
   },
   "text": {
    "empty_scene_rule": "drop from that layer's timeline; counted",
    "excluded_tags": [
     "stage_direction",
     "character",
     "parenthetical"
    ],
    "layers": [
     "dialogue",
     "action",
     "both"
    ],
    "normalise_split_contractions": true,
    "primary_layer": "both",
    "sentence_split_regex": "(?<=[.!?])[\"')\\]]*\\s+",
    "split_contraction_regex": "(\\w)\\s+(n't|'s|'re|'ve|'ll|'d|'m)\\b",
    "unit_of_time": "scene",
    "word_regex": "[A-Za-z]+(?:'[A-Za-z]+)?"
   }
  }
 },
 "s03_compute_check": {
  "config": "03e51e86b0",
  "date": "2026-11-14",
  "outputs": [
   "s03_compute_check.json"
  ],
  "params": {
   "instruments": {
    "compute_check_sentences": 200,
    "contextual": {
     "batch_size": 64,
     "chunking": "a sentence longer than 510 word pieces is cut into consecutive 510-piece chunks, scored, and averaged (counted)",
     "max_tokens": 512,
     "name": "distilbert-base-uncased-finetuned-sst-2-english",
     "score": "P(positive) - P(negative)"
    },
    "lexicon": {
     "name": "vader",
     "neutral_band": 0.05
    },
    "max_runtime_hours": 3.0,
    "step11_instrument": "vader"
   }
  }
 }
